@model CollegeEnrollmentSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete</h1>

<h3>
    Are you sure you want to delete
    <strong>@Model.FirstName @Model.LastName</strong>?
</h3>

<div>
    <h4>Student Details</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.FirstName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.FirstName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.LastName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.LastName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Email)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Age)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Age)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mt-3">
            <button type="submit" class="btn btn-danger me-2">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>
