@model CollegeEnrollmentSystem.ViewModels.Students.StudentDetailsViewModel

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">First Name</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">Last Name</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Age</dt>
    <dd class="col-sm-9">@Model.Age</dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">Edit</a>

    <a asp-action="Index"
       class="btn btn-secondary ms-2">Back to List</a>
</div>
